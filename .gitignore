# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive infrastructure data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude local variable files that may hold sensitive values
terraform.tfvars
*.auto.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore local SSH private/public keys if stored in project folder
*.pem
*.key
*_rsa
*_ed25519

